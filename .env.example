# Copy this file to .env and fill in your own values.
# Never commit your actual .env file to version control.

# Groq API Key — get yours free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/placement_prep

# Gmail SMTP credentials (use an App Password, not your real password)
# See: https://myaccount.google.com/apppasswords
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here

# Signs login sessions and one-time codes. REQUIRED - the app won't start without it.
# start.ps1 generates one automatically; or run:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# SECRET_KEY=

# DSA code execution: runs only inside Docker by default. Setting this to "local" runs
# submitted code directly on this computer - only do that on a private dev machine.
# PREPWISE_SANDBOX=local

# Development only: turns on the Flask debugger (and shows sign-in codes in the console
# when MAIL_* isn't set). Never set this on a server.
# FLASK_DEBUG=1

# Development only: show sign-in codes in the console without enabling the debugger.
# PREPWISE_PRINT_OTP=1

# Production (see README "Running it for other people"): served over HTTPS behind a proxy.
# PREPWISE_HTTPS=1
# PREPWISE_TRUST_PROXY=1

# Breached-password check (Have I Been Pwned range API). On by default; skipped when offline.
# PREPWISE_HIBP=off

# If the remote DATABASE_URL is unreachable, fall back to local SQLite instead of stopping.
# PREPWISE_ALLOW_SQLITE_FALLBACK=1
